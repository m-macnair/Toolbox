#!/bin/bash
_FIREWALLROOT="$(dirname ./)"
source $_FIREWALLROOT/conf/firewall.conf
source $_FIREWALLROOT/conf/blacklist.conf
echo "Processing Blacklist..."

#logged port black list 
echo "Log + black listing ports"
name="in_port_logged_bl"
init_chain "$name"
for port in "${in_port_logged_bl[@]}"
do
	$IPT -A $name -j LOG --log-prefix "$name:"
	$IPT -A $name -j DROP
done
$IPT -I tcp_inbound  -j "$name"
#logged host black list 


echo "Log + black listing hosts"
name="in_host_logged_bl"
init_chain "$name"
for host in "${in_host_logged_bl[@]}"
do
	$IPT -A $name -j LOG --log-prefix "$name:"
	$IPT -I $name -s "$host/32" -j DROP
done
$IPT -I tcp_inbound  -j "$name"


echo "Log + black listing outbound ports"
name="out_port_logged_bl"
init_chain "$name"
for host in "${out_port_logged_bl[@]}"
do
	$IPT -A $name -j LOG --log-prefix "$name:"
	$IPT -A $name -j DROP
done
$IPT -I tcp_outbound  -j "$name"


echo "National Blacklists"
#national blacklist
